{
  "swagger": "2.0",
  "info": {
    "title": "NombresMad API",
    "description": "API for wooden name plates stored in Postgres.",
    "version": "1.0.0"
  },
  "basePath": "/",
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "App bearer token returned by POST /api/login or /api/login/google"
    }
  },
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    {"name": "items", "description": "Name plate records"},
    {"name": "admin", "description": "Database setup"}
  ],
  "paths": {
    "/api/login": {
      "post": {
        "tags": ["admin"],
        "summary": "Emergency password login",
        "description": "Emergency password fallback: checks the configured email and password, returning an app token valid for 12 hours.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "username": {"type": "string", "format": "email"},
              "password": {"type": "string"}
            }
          }
        }],
        "responses": {
          "200": {"description": "Logged in", "schema": {"$ref": "#/definitions/Session"}},
          "400": {"description": "Malformed request body", "schema": {"type": "string"}},
          "401": {"description": "Unauthorized", "schema": {"type": "string"}},
          "413": {"description": "Request body is too large", "schema": {"type": "string"}}
        }
      }
    },
    "/api/login/google": {
      "post": {
        "tags": ["admin"],
        "summary": "Log in with Google",
        "description": "Verifies a Google Identity Services ID token for the configured OAuth client, requires a verified email on the server-side allowlist, and returns an app token valid for 12 hours.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "required": ["credential"],
            "properties": {
              "credential": {"type": "string", "description": "Google ID token credential"}
            }
          }
        }],
        "responses": {
          "200": {"description": "Logged in", "schema": {"$ref": "#/definitions/Session"}},
          "400": {"description": "Malformed request body", "schema": {"type": "string"}},
          "401": {"description": "Unauthorized, invalid credential, or email is not allowlisted", "schema": {"type": "string"}},
          "413": {"description": "Request body is too large", "schema": {"type": "string"}}
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["admin"],
        "summary": "Log out",
        "description": "Ends the browser session. The client must discard the bearer token.",
        "produces": ["application/json"],
        "responses": {
          "200": {"description": "Logged out", "schema": {"$ref": "#/definitions/Status"}}
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": ["admin"],
        "summary": "Current session",
        "description": "Requires Authorization: Bearer <token>.",
        "security": [{"Bearer": []}],
        "produces": ["application/json"],
        "responses": {
          "200": {"description": "Logged in", "schema": {"$ref": "#/definitions/Session"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}}
        }
      }
    },
    "/api/account/password": {
      "post": {
        "tags": ["admin"],
        "summary": "Change the current admin password",
        "description": "Allowed while a password change is required. Replaces the stored hash and returns a new bearer token. The previous token stops working.",
        "security": [{"Bearer": []}],
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "currentPassword": {"type": "string"},
              "newPassword": {"type": "string", "minLength": 8}
            }
          }
        }],
        "responses": {
          "200": {"description": "Password changed", "schema": {"$ref": "#/definitions/Session"}},
          "400": {"description": "Rejected password", "schema": {"type": "string"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}}
        }
      }
    },
    "/api/admins": {
      "get": {
        "tags": ["admin"],
        "summary": "List administrators",
        "description": "Requires an administrator who has already changed the default password. Password hashes are not returned.",
        "security": [{"Bearer": []}],
        "responses": {
          "200": {
            "description": "Administrators",
            "schema": {"type": "object", "properties": {"admins": {"type": "array", "items": {"$ref": "#/definitions/Admin"}}}}
          },
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}}
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Create an administrator",
        "description": "Any administrator who has chosen a password can create another one. The username must be an email address. The account receives the default password from ADMIN_PASSWORD and must change it at first login.",
        "security": [{"Bearer": []}],
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {"type": "object", "properties": {"username": {"type": "string", "format": "email"}}}
        }],
        "responses": {
          "200": {"description": "Created", "schema": {"$ref": "#/definitions/Admin"}},
          "400": {"description": "Username is not an email, or the default password is missing", "schema": {"type": "string"}},
          "409": {"description": "Username already exists", "schema": {"type": "string"}}
        }
      }
    },
    "/api/admins/reset": {
      "post": {
        "tags": ["admin"],
        "summary": "Reset another administrator to the default password",
        "description": "Sets that account's password to ADMIN_PASSWORD and requires a change at the next login. The caller's own account cannot be reset this way.",
        "security": [{"Bearer": []}],
        "parameters": [{
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {"type": "object", "properties": {"username": {"type": "string", "format": "email"}}}
        }],
        "responses": {
          "200": {"description": "Reset", "schema": {"$ref": "#/definitions/Status"}},
          "400": {"description": "Rejected reset", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}}
        }
      }
    },
    "/api/items": {
      "get": {
        "tags": ["items"],
        "summary": "List items",
        "description": "Returns one page of items. Page size defaults to 25 and can be raised up to 60. Filters and sort run in the database.",
        "produces": ["application/json"],
        "parameters": [
          {"name": "page", "in": "query", "type": "integer", "default": 1, "description": "Page number, starting at 1"},
          {"name": "pageSize", "in": "query", "type": "integer", "default": 25, "description": "Items per page, from 1 to 60"},
          {"name": "sort", "in": "query", "type": "string", "default": "id", "enum": ["id", "dateCreated", "text", "size", "thicknesses", "woodType", "deliveryDate", "deliveredTo", "group", "price", "deliveredWithBox"]},
          {"name": "order", "in": "query", "type": "string", "default": "asc", "enum": ["asc", "desc"]},
          {"name": "q", "in": "query", "type": "string", "description": "Case-insensitive match on name, group, wood, recipient, size, or thickness"},
          {"name": "group", "in": "query", "type": "string", "description": "Case-insensitive match on group"},
          {"name": "name", "in": "query", "type": "string", "description": "Case-insensitive match on the name"},
          {"name": "size", "in": "query", "type": "string", "description": "Exact size"},
          {"name": "woodType", "in": "query", "type": "string", "description": "Exact wood type"},
          {"name": "hasPicture", "in": "query", "type": "boolean", "description": "True when the item has a picture"},
          {"name": "delivered", "in": "query", "type": "boolean", "description": "True when Entregado a is filled in. False when that field is empty."},
          {"name": "deliveredWithBox", "in": "query", "type": "boolean", "description": "Filter by box delivery"}
        ],
        "responses": {
          "200": {"description": "One page of items", "schema": {"$ref": "#/definitions/ItemPage"}},
          "400": {"description": "Invalid page, sort, order, or filter", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      },
      "post": {
        "tags": ["items"],
        "summary": "Create an item",
        "security": [{"Bearer": []}],
        "description": "Inserts an item. The server assigns id.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {"$ref": "#/definitions/ItemInput"}
          }
        ],
        "responses": {
          "200": {"description": "Created item", "schema": {"$ref": "#/definitions/Item"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "400": {"description": "Invalid JSON", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      }
    },
    "/api/items/{id}": {
      "get": {
        "tags": ["items"],
        "summary": "Get an item",
        "produces": ["application/json"],
        "parameters": [{"$ref": "#/parameters/itemId"}],
        "responses": {
          "200": {"description": "The item", "schema": {"$ref": "#/definitions/Item"}},
          "400": {"description": "Missing or invalid id", "schema": {"type": "string"}},
          "404": {"description": "Not found", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      },
      "put": {
        "tags": ["items"],
        "summary": "Update an item",
        "security": [{"Bearer": []}],
        "description": "Replaces the fields of the item identified by the path id.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {"$ref": "#/parameters/itemId"},
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {"$ref": "#/definitions/ItemInput"}
          }
        ],
        "responses": {
          "200": {"description": "Updated item", "schema": {"$ref": "#/definitions/Item"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "404": {"description": "Not found", "schema": {"type": "string"}},
          "400": {"description": "Missing, invalid id, or invalid JSON", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      },
      "delete": {
        "tags": ["items"],
        "summary": "Delete an item",
        "security": [{"Bearer": []}],
        "produces": ["application/json"],
        "parameters": [{"$ref": "#/parameters/itemId"}],
        "responses": {
          "200": {"description": "Deleted", "schema": {"$ref": "#/definitions/Status"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "404": {"description": "Not found", "schema": {"type": "string"}},
          "400": {"description": "Missing or invalid id", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      }
    },
    "/api/items/{id}/picture": {
      "get": {
        "tags": ["items"],
        "summary": "Get an item picture",
        "produces": ["image/jpeg", "image/png", "image/gif", "image/webp"],
        "parameters": [{"$ref": "#/parameters/itemId"}],
        "responses": {
          "200": {"description": "Image bytes"},
          "404": {"description": "Item or picture not found", "schema": {"type": "string"}},
          "500": {"description": "Read error", "schema": {"type": "string"}}
        }
      },
      "post": {
        "tags": ["items"],
        "summary": "Upload or replace an item picture",
        "security": [{"Bearer": []}],
        "description": "Accepts one image file (JPEG, PNG, GIF, or WebP) up to 8 MB in the form field file. Replaces any picture already stored for the item.",
        "consumes": ["multipart/form-data"],
        "produces": ["application/json"],
        "parameters": [
          {"$ref": "#/parameters/itemId"},
          {"name": "file", "in": "formData", "type": "file", "required": true, "description": "Image file"}
        ],
        "responses": {
          "200": {"description": "Item with the stored picture name", "schema": {"$ref": "#/definitions/Item"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "400": {"description": "Missing, too large, or unsupported image", "schema": {"type": "string"}},
          "404": {"description": "Item not found", "schema": {"type": "string"}},
          "500": {"description": "Database or disk error", "schema": {"type": "string"}}
        }
      },
      "delete": {
        "tags": ["items"],
        "summary": "Remove an item picture",
        "security": [{"Bearer": []}],
        "produces": ["application/json"],
        "parameters": [{"$ref": "#/parameters/itemId"}],
        "responses": {
          "200": {"description": "Item without a picture", "schema": {"$ref": "#/definitions/Item"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "404": {"description": "Item not found", "schema": {"type": "string"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      }
    },
    "/api/options": {
      "get": {
        "tags": ["items"],
        "summary": "List filter choices",
        "description": "Distinct wood types, groups, and sizes currently stored.",
        "produces": ["application/json"],
        "responses": {
          "200": {"description": "Filter choices", "schema": {"$ref": "#/definitions/Options"}},
          "500": {"description": "Database error", "schema": {"type": "string"}}
        }
      }
    },
    "/api/import": {
      "post": {
        "tags": ["admin"],
        "summary": "Reload items from initial_load.json",
        "security": [{"Bearer": []}],
        "description": "Replaces every row in items with the contents of initial_load.json and deletes stored pictures. Startup already loads that file when the table is empty.",
        "produces": ["application/json"],
        "responses": {
          "200": {"description": "Imported", "schema": {"$ref": "#/definitions/Status"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "405": {"description": "Method not allowed", "schema": {"type": "string"}},
          "500": {"description": "Read or database error", "schema": {"type": "string"}}
        }
      }
    },
    "/api/migrate": {
      "post": {
        "tags": ["admin"],
        "summary": "Apply migrations.sql",
        "security": [{"Bearer": []}],
        "description": "Runs migrations.sql. Startup already applies it.",
        "produces": ["application/json"],
        "responses": {
          "200": {"description": "Migrated", "schema": {"$ref": "#/definitions/Status"}},
          "401": {"description": "Not logged in", "schema": {"type": "string"}},
          "403": {"description": "Password change required", "schema": {"type": "string"}},
          "405": {"description": "Method not allowed", "schema": {"type": "string"}},
          "500": {"description": "Migration error", "schema": {"type": "string"}}
        }
      }
    }
  },
  "parameters": {
    "itemId": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "integer",
      "description": "Item id"
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "id": {"type": "integer", "example": 1},
        "dateCreated": {"type": "string", "example": "15/09/1999"},
        "text": {"type": "string", "example": "LAURA"},
        "size": {"type": "string", "example": "5"},
        "thicknesses": {"type": "string", "example": "20"},
        "woodType": {"type": "string", "example": "TECA"},
        "deliveryDate": {"type": "string", "example": "15/09/1999"},
        "deliveredTo": {"type": "string", "example": "LAURA-AGUSTIN"},
        "group": {"type": "string", "example": "CRUCI"},
        "price": {"type": "integer", "example": 0},
        "deliveredWithBox": {"type": "boolean", "example": false},
        "picture": {"type": "string", "example": "1-1710000000000000000.jpg", "description": "Stored file name. Empty when the item has no picture."}
      }
    },
    "ItemInput": {
      "type": "object",
      "properties": {
        "dateCreated": {"type": "string"},
        "text": {"type": "string"},
        "size": {"type": "string"},
        "thicknesses": {"type": "string"},
        "woodType": {"type": "string"},
        "deliveryDate": {"type": "string"},
        "deliveredTo": {"type": "string"},
        "group": {"type": "string"},
        "price": {"type": "integer"},
        "deliveredWithBox": {"type": "boolean"}
      }
    },
    "ItemPage": {
      "type": "object",
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/definitions/Item"}},
        "page": {"type": "integer", "example": 1},
        "pageSize": {"type": "integer", "example": 25},
        "total": {"type": "integer", "example": 1914},
        "totalPages": {"type": "integer", "example": 77}
      }
    },
    "Options": {
      "type": "object",
      "properties": {
        "woodTypes": {"type": "array", "items": {"type": "string"}},
        "groups": {"type": "array", "items": {"type": "string"}},
        "sizes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Session": {
      "type": "object",
      "properties": {
        "username": {"type": "string"},
        "token": {"type": "string", "description": "Present after login and after a password change."},
        "mustChangePassword": {"type": "boolean"}
      }
    },
    "Admin": {
      "type": "object",
      "properties": {
        "username": {"type": "string"},
        "mustChangePassword": {"type": "boolean"}
      }
    },
    "Status": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "example": "imported"}
      }
    }
  }
}
